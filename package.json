{
  "name": "hansen-solvent-app",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop application for Hansen solubility parameter analysis, solvent selection and scientific data traceability.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron dist/main/main.cjs",
    "dev": "node scripts/dev.mjs",
    "e2e": "npm run e2e:test",
    "e2e:test": "npm run build && node scripts/run-e2e.mjs",
    "e2e:linux": "npm run build && xvfb-run -a electron --no-sandbox --disable-gpu --enable-unsafe-swiftshader e2e/smoke.cjs",
    "audit:prod": "npm audit --omit=dev",
    "package:win": "npm run build && electron-builder --win dir portable --x64 --config electron-builder.yml",
    "verify:package": "node scripts/verify-packaged-app.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "main": "dist/main/main.cjs",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "electron-winstaller": false
  },
  "author": {
    "name": "Vincent Nicolas"
  },
  "productName": "Hansen Solvent App"
}
